package atividadeExercicios;

import javax.swing.JOptionPane;

public class Exerc01Lista01 {

    public static void main(String[] args) {
        
        String numero1Str = JOptionPane.showInputDialog(null, "Digite o primeiro número");
        String numero2Str = JOptionPane.showInputDialog(null, "Digite o segundo número");

        try {
            double numero1 = Double.parseDouble(numero1Str);
            double numero2 = Double.parseDouble(numero2Str);

            JOptionPane.showMessageDialog(
                null,
                "Soma: " + (numero1 + numero2) +
                "\nSubtração: " + (numero1 - numero2) +
                "\nMultiplicação: " + (numero1 * numero2) +
                "\nDivisão: " + (numero1 / numero2)
            );
        }
        catch(NumberFormatException erro) {
            JOptionPane.showMessageDialog(null, "Digite um número válido: " + erro);
        }
    }   
}
